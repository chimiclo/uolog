<header class="navbar">
  <div class="navbar-container">
    <div class="logo">
      <%= link_to root_path do %>
        <i class="fa-solid fa-fish"></i>
        UOLOG
      <% end %>
    </div>

    <nav class="nav-links">
      <ul>
        <li><%= link_to root_path do %>
          <i class="fa-solid fa-house"></i> ホーム
        <% end %></li>

        <% if user_signed_in? %>
          <li><%= link_to profile_path do %>
            <i class="fa-solid fa-user"></i> マイページ
          <% end %></li>

          <li><%= link_to new_catch_path do %>
            <i class="fa-solid fa-book"></i> 釣果を投稿
          <% end %></li>

          <li><%= link_to destroy_user_session_path,method: :delete do %>
            <i class="fa-solid fa-right-from-bracket"></i> ログアウト
          <% end %></li>
        <% else %>
          <li><%= link_to new_user_session_path do %>
            <i class="fa-solid fa-right-to-bracket"></i> ログイン
          <% end %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
