<div class="auth-container">
  <h2>ログイン</h2>

  <%= form_with model: resource, url: session_path(resource_name) do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, class: "auth-input" %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, class: "auth-input" %>
    </div>

    <div class="actions">
      <%= f.submit "ログイン", class: "auth-btn" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
