<div class="auth-container">
  <h2>新規登録</h2>

  <%= form_with model: resource, url: registration_path(resource_name) do |f| %>
    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, class: "auth-input" %>
    </div>

    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password, class: "auth-input" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, class: "auth-input" %>
    </div>

    <div class="actions">
      <%= f.submit "アカウント作成", class: "auth-btn" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
