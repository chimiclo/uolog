<div class="auth-container">
  <h2 class="auth-title">新規登録</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, class: "auth-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, class: "auth-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "パスワード（確認）" %>
      <%= f.password_field :password_confirmation, class: "auth-input" %>
    </div>

    <%= f.submit "アカウントを作成", class: "auth-btn" %>
  <% end %>

  <div class="auth-links">
    <%= link_to "ログインはこちら", new_user_session_path %>
  </div>
</div>
