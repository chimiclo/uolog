<div class="catch-show-container">

  <div class="catch-author-box">
    <div class="author-left">
      <% if @catch.user.profile.avatar.attached? && @catch.user.profile.avatar.variable? %>
        <%= image_tag @catch.user.profile.avatar.variant(resize_to_fill: [60, 60]),
                      class: "author-avatar" %>
      <% else %>
        <div class="author-avatar author-avatar-placeholder">👤</div>
      <% end %>

      <div class="author-info">
        <%= link_to @catch.user.profile.name,
              user_profile_path(@catch.user),
              class: "author-name author-link" %>
      </div>
    </div>
  </div>

  <div class="catch-swiper-container">
  <% if @catch.images.attached? %>
    <div class="swiper myCatchSwiper">
      <div class="swiper-wrapper">
        <% @catch.images.each do |img| %>
          <div class="swiper-slide">
            <% if img.variable? %>
              <%= image_tag img.variant(resize_to_limit: [1200, 800]), class: "catch-image" %>
            <% else %>
              <%= image_tag img, class: "catch-image" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>

    <div class="swiper myThumbsSwiper">
      <div class="swiper-wrapper">
        <% @catch.images.each do |img| %>
          <div class="swiper-slide thumb-slide">
            <%= image_tag img.variant(resize_to_fill: [120, 120]),
                          class: "thumb-image" %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="no-image-box">
      No Image
    </div>
  <% end %>
</div>

  <div class="catch-info-card">
    <div class="card-header">
      <h2>🐟 <%= @catch.fish_name %></h2>
    </div>

    <div class="info-row">
      <span>日付</span>
      <span><%= @catch.caught_on %></span>
    </div>

    <div class="info-row">
      <span>サイズ</span>
      <span><%= @catch.size %> cm</span>
    </div>

    <div class="info-row">
      <span>場所</span>
      <span><%= @catch.location %></span>
    </div>

    <div class="info-row">
      <span>状況</span>
      <span><%= @catch.condition %></span>
    </div>

    <div class="info-row">
      <span>タックル</span>
      <span><%= @catch.tackle %></span>
    </div>

    <div class="memo-box">
      <h3>メモ</h3>
      <div class="memo-content">
        <%= simple_format(@catch.memo) %>
      </div>
    </div>

    <div
      id="uolog-map"
      data-lat="<%= @catch.latitude || 26.3344 %>"
      data-lng="<%= @catch.longitude || 127.8056 %>"
      style="height: 300px; margin-top: 20px;">
    </div>
  </div>

  <% if @catch.user == current_user %>
  <div class="catch-action-buttons">
    <%= link_to "編集する",
          edit_catch_path(@catch),
          class: "btn btn-primary" %>

    <%= button_to "削除する",
          catch_path(@catch),
          method: :delete,
          form: { onsubmit: "return confirm('本当にこの釣果を削除しますか？');" },
          class: "btn btn-danger" %>

    <%= link_to "一覧へ戻る",
          catches_path,
          class: "btn btn-secondary" %>
  </div>
<% else %>
  <div class="catch-action-buttons">
    <%= link_to "一覧へ戻る",
          catches_path,
          class: "btn btn-secondary" %>
  </div>
<% end %>

<%= javascript_include_tag "show_map", defer: true %>
<%= javascript_include_tag "swiper_init", defer: true %>
