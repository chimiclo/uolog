<div class="form-group">
  <%= form.label :images, "釣果画像" %>
  <%= form.file_field :images, multiple: true, class: "form-control", accept: "image/*" %>

  <% if catch.images.attached? %>
    <div class="edit-image-list">
      <% catch.images.each do |image| %>
        <div class="edit-image-box">

          <%= image_tag image.variant(resize_to_fill: [150, 150]),
                        class: "edit-image" %>

          <div class="image-delete-row">
            <%= form.check_box :remove_image_ids,
              { multiple: true },
              image.id,
              nil %>
            <label>削除</label>
          </div>

        </div>
      <% end %>
    </div>
  <% end %>
</div>

