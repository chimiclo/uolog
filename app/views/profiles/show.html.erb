<div style="
  max-width: 500px;
  margin: 50px auto;
  padding: 30px;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  text-align: center;
">

  <h1 style="margin-bottom: 20px; color: #333;">マイページ</h1>

  <div style="margin-bottom: 20px;">
    <strong style="color: #555;">名前:</strong><br>
    <span style="font-size: 18px; color: #222;"><%= @profile.name %></span>
  </div>

  <div style="margin-bottom: 20px;">
    <strong style="color: #555;">釣りスタイル:</strong><br>
    <span style="font-size: 18px; color: #222;"><%= @profile.style %></span>
  </div>

  <div style="margin-bottom: 20px;">
    <strong style="color: #555;">よく行くエリア:</strong><br>
    <span style="font-size: 18px; color: #222;"><%= @profile.area %></span>
  </div>

  <div style="margin-bottom: 20px;">
    <strong style="color: #555;">コメント:</strong><br>
    <span style="font-size: 18px; color: #222;"><%= @profile.comment %></span>
  </div>

  <%= link_to "プロフィールを編集する",
    edit_profile_path,
    style: "
      display:inline-block;
      padding:12px 25px;
      margin-top:20px;
      background:#4CAF50;
      color:white;
      border-radius:8px;
      text-decoration:none;
      font-weight:bold;
    "
  %>

</div>
