<div class="container">
  <div class="profile-page">
    <div class="profile-card">

      <div class="profile-avatar-wrapper">
        <% if @profile.avatar.attached? %>
          <%= image_tag @profile.avatar.variant(resize_to_fill: [160, 160]),
                        class: "profile-avatar" %>
        <% else %>
          <div class="profile-avatar placeholder">👤</div>
        <% end %>
      </div>

      <h2 class="profile-name"><%= @profile.name %></h2>

      <div class="profile-badge">
        <span class="badge-icon">🎣</span>
        <span class="badge-count"><%= @catches_count %></span>
        <span class="badge-label">釣果</span>
      </div>

      <div class="profile-item">
        <span class="label">釣りスタイル</span>
        <span class="value"><%= @profile.style.presence || "未設定" %></span>
      </div>

      <div class="profile-item">
        <span class="label">よく行くエリア</span>
        <span class="value"><%= @profile.area.presence || "未設定" %></span>
      </div>

      <div class="profile-item">
        <span class="label">コメント</span>
        <span class="value"><%= @profile.comment.presence || "未設定" %></span>
      </div>

      <% if @user == current_user %>
        <div class="profile-edit-btn">
          <%= link_to "プロフィールを編集する",
                edit_profile_path,
                class: "btn btn-primary" %>
        </div>
      <% end %>

    </div>

    <h2 class="section-title">
      🎣 <%= @user == current_user ? "自分の釣果" : "#{@profile.name}の釣果" %>
    </h2>

    <% if @catches.any? %>
      <div class="catches-index">
        <% @catches.each do |catch| %>
          <div class="catch-card">

            <% if catch.images.attached? %>
              <%= image_tag catch.images.first.variant(resize_to_fill: [300, 300]) %>
            <% else %>
              <div class="no-image">No Image</div>
            <% end %>

            <div class="catch-card-body">
              <div class="catch-fish-name"><%= catch.fish_name %></div>

              <div class="catch-meta">
                <span>📅 <%= catch.caught_on %></span>
                <span>📍 <%= catch.location %></span>
              </div>

              <%= link_to "詳細を見る",
                    catch_path(catch),
                    class: "btn btn-secondary btn-small" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="pagination-wrapper">
        <%= paginate @catches %>
      </div>

    <% else %>
      <p class="no-catches-text">まだ釣果が投稿されていません。</p>
    <% end %>

  </div>
</div>
