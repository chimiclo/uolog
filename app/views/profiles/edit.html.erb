<div class="container">
  <div class="profile-edit-card">

    <h2 class="profile-edit-title">マイページ編集</h2>

    <%= form_with model: @profile, url: profile_path, local: true do |f| %>

      <div class="form-group">
        <%= f.label :avatar, "プロフィール画像" %>
        <%= f.file_field :avatar, accept: "image/*" %>
      </div>

      <div class="form-group">
        <%= f.label :name, "名前" %>
        <%= f.text_field :name, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :style, "釣りスタイル" %>
        <%= f.text_field :style, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :area, "よく行くエリア" %>
        <%= f.text_field :area, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :comment, "コメント" %>
        <%= f.text_area :comment, rows: 4, class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= f.submit "更新する", class: "btn btn-primary" %>
      </div>

    <% end %>

    <div class="form-back">
      <%= link_to "戻る", profile_path, class: "btn-back" %>
    </div>
  </div>
</div>
